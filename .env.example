# Docker Compose 自动读取同目录下的 .env。
ARIA_PORT=8787
ARIA_USERNAME=aria
ARIA_PASSWORD=change-me-to-a-long-random-password
TZ=Asia/Shanghai

# 容器 DNS。部分媒体 CDN 只有 IPv4，宿主机 DNS 的 AAAA 查询抖动会导致取链失败。
CONTAINER_DNS_PRIMARY=223.5.5.5
CONTAINER_DNS_SECONDARY=119.29.29.29

# 音源脚本允许导入的域名，多个域名用逗号分隔。
SOURCE_ALLOWED_HOSTS=raw.githubusercontent.com,gh-proxy.org
DEFAULT_SOURCES_ENABLED=1

# 调试日志
DEBUG_ROUTING=0
DEBUG_HTTP=0

# 可选：额外限制媒体代理可访问的 CDN 域名，多个域名用逗号分隔。
# MEDIA_ALLOWED_HOSTS=music.126.net,qq.com
